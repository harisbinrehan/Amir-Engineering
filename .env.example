# Supabase project settings (Project Settings → API in the Supabase dashboard).
# The anon key is safe to expose to the browser. NEVER expose the service role key
# to the client — it bypasses Row Level Security entirely.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for metadata/OG tags/sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (resend.com) — sends order confirmation / account emails.
# Get an API key from the Resend dashboard → API Keys.
RESEND_API_KEY=your-resend-api-key
# Must be an address on a domain verified in Resend → Domains, e.g.
# "Amir Engineering <orders@amirengineering.com>". Until a domain is verified,
# Resend only delivers to the email the Resend account itself was created with.
RESEND_FROM_EMAIL=Amir Engineering <onboarding@resend.dev>
